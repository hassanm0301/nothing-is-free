<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Glyph groundwork: the Glyph Matrix SDK needs this permission at runtime on Nothing
      devices. Declaring it has no effect elsewhere. Enabled when Glyph work starts.
      <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />
    -->

    <application
        android:name=".NothingIsFreeApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NothingIsFree.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NothingIsFree.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Widget receivers (Glance) and Glyph Toy services will be registered here. -->
    </application>

</manifest>
