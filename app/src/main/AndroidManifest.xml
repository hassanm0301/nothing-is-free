<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Glyph Matrix SDK access on Nothing devices. Declaring it has no effect elsewhere. -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />
    <!-- Keeps the clock toy's notification pulse animating while the screen is off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Self-update: fetch the latest GitHub release and install its APK. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".NothingIsFreeApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NothingIsFree.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NothingIsFree.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Feeds the clock toy's pulse. Needs notification access, granted from the app. -->
        <service
            android:name=".core.notifications.GlyphNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          Glyph Toy: bound by Nothing's Glyph service, which holds no permission we could require.
          It only accepts "redraw" events, so being exported is harmless.
        -->
        <service
            android:name=".glyph.toy.ClockToyService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/clock_toy_name" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/clock_toy_preview" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/clock_toy_summary" />
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1" />
        </service>

        <!-- PackageInstaller status for self-updates; only our own PendingIntent targets it. -->
        <receiver
            android:name=".core.update.InstallResultReceiver"
            android:exported="false" />

        <!-- Widget receivers (Glance) will be registered here. -->
    </application>

</manifest>
