<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Glyph Matrix SDK access on Nothing devices. Declaring it has no effect elsewhere. -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />
    <!-- Keeps the notification pulse addon animating while the screen is off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Self-update: fetch the latest GitHub release and install its APK. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Clock widget: its redraw on the minute, with an alarm that doesn't wake the phone. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Clock widget: a tap opens the clock app's alarms, which clock apps guard with this. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <application
        android:name=".NothingIsFreeApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NothingIsFree.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NothingIsFree.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Feeds the notification pulse addon. Needs notification access, granted from the app. -->
        <service
            android:name=".core.notifications.GlyphNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          Glyph Toys: bound by Nothing's Glyph service, which holds no permission we could require.
          They only accept "redraw" events, so being exported is harmless.
        -->
        <service
            android:name=".glyph.toy.ClockToyService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/clock_toy_name" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/clock_toy_preview" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/clock_toy_summary" />
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1" />
        </service>

        <service
            android:name=".glyph.toy.BinaryClockToyService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/binary_clock_name" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/binary_clock_preview" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/binary_clock_summary" />
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1" />
        </service>

        <service
            android:name=".glyph.toy.CompactClockToyService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/compact_clock_name" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/compact_clock_preview" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/compact_clock_summary" />
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1" />
        </service>

        <service
            android:name=".glyph.toy.AnalogClockToyService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/analog_clock_name" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/analog_clock_preview" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/analog_clock_summary" />
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1" />
        </service>

        <!-- PackageInstaller status for self-updates; only our own PendingIntent targets it. -->
        <receiver
            android:name=".core.update.InstallResultReceiver"
            android:exported="false" />

        <!--
          Precise volume: the volume level as text beside the system volume bar. Switched on by
          the user in Accessibility settings; the permission means only the system can bind it.
        -->
        <service
            android:name=".volume.PreciseVolumeService"
            android:exported="true"
            android:label="@string/precise_volume_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/precise_volume_service" />
        </service>

        <!--
          Clock widget. Besides the launcher's updates it takes the broadcasts that change what it
          shows; all four may be declared here (they are exempt from the implicit broadcast limits).
          The minute tick is sent to it by name. Not exported: only the system sends any of these.
        -->
        <receiver
            android:name=".widget.ClockWidgetProvider"
            android:exported="false"
            android:label="@string/clock_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clock_widget_info" />
        </receiver>
    </application>

</manifest>
