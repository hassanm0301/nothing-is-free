<?xml version="1.0" encoding="utf-8"?>
<!--
  Essential key (essentialkey/EssentialKeyService). Key events only: it asks for no accessibility
  event types and can't read window content. Not an accessibility tool, so it says so.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:description="@string/essential_key_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="100"
    android:summary="@string/essential_key_summary" />
